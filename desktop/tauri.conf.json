{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMXMapForge",
  "version": "3.18.0",
  "identifier": "com.tmxmapforge.desktop",
  "build": {
    "frontendDist": "../app/src/main/assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "铁锈战争地图生成器 · PC 版",
        "width": 1366,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "铁锈战争（Rusted Warfare）TMX 地图生成器",
    "longDescription": "完全离线的铁锈战争地图生成、编辑与导出工具（PC 版）。",
    "copyright": "TMX MapForge",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
